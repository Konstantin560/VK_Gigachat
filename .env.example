# Скопируйте этот файл в .env и заполните значения своими секретами.
# Никогда не коммитьте .env в Git: он уже добавлен в .gitignore.

# Токен доступа сообщества ВКонтакте (Community access token).
# Создаётся в настройках сообщества: Управление -> Работа с API -> Ключи доступа.
# Боту нужны права: messages (сообщения) и groups (для настройки бота).
VK_GROUP_TOKEN=

# ID сообщества ВКонтакте (только число, из адреса https://vk.com/club12345678 это 12345678).
VK_GROUP_ID=

# Версия VK API (оставьте по умолчанию).
VK_API_VERSION=

# Ключ авторизации GigaChat (Authorization key, строка Base64 из Client ID и Client Secret).
# Выдаётся в личном кабинете GigaChat API (developers.sber.ru) после создания проекта.
GIGACHAT_AUTH_KEY=

# Scope (версия API) GigaChat: GIGACHAT_API_PERS (физлица) / GIGACHAT_API_B2B / GIGACHAT_API_CORP.
GIGACHAT_SCOPE=

# Название модели GigaChat: GigaChat / GigaChat-2-Pro / GigaChat-2-Max и др.
GIGACHAT_MODEL=

# Проверять ли SSL-сертификат при обращении к GigaChat (true/false).
# Для некоторых тарифов GigaChat требует отключения проверки сертификатов.
GIGACHAT_VERIFY_SSL=
